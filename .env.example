# Skufia-Net Production Environment Configuration

# Database Credentials
POSTGRES_USER=skufia_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=skufia_prod

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# CoTURN STUN/TURN Secret
TURN_SECRET=your_secure_turn_secret_here
TURN_REALM=skufia.local

# JWT Secret for Auth (optional, if utilized in python)
JWT_SECRET=your_secure_jwt_secret_here

{
  "name": "skufia-deploy",
  "version": "1.0.0",
  "description": "Smart local CI/CD pipeline для Скуфия",
  "scripts": {
    "deploy": "node deploy.js",
    "deploy:skip-tests": "node deploy.js --skip-tests",
    "test:unit": ".venv/Scripts/python -m pytest tests/backend/unit -v",
    "test:unit:chat": ".venv/Scripts/python -m pytest tests/backend/unit/test_chat_pipeline.py -v --noconftest",
    "test:api": ".venv/Scripts/python -m pytest tests/backend/integration -v",
    "test:api:chat": ".venv/Scripts/python -m pytest tests/backend/integration/test_chat_api.py -v",
    "test:e2e": "npx playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:chat": "npx playwright test tests/e2e/chat-pipeline.spec.ts --config=tests/e2e/playwright.config.ts",
    "test:e2e:ui": "npx playwright test tests/e2e/chat-pipeline.spec.ts --config=tests/e2e/playwright.config.ts --headed",
    "test:pyramid": ".venv/Scripts/python -m pytest tests/backend/unit/test_chat_pipeline.py --noconftest -q && npx playwright test tests/e2e/chat-pipeline.spec.ts --config=tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
